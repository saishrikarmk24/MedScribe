# ---------------------------------------------------------------------------
# MedScribe Live - environment configuration
# Copy this file to .env and fill in your values.
# ---------------------------------------------------------------------------

# --- AI provider -----------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# gemini | mock   (mock = deterministic rule-based provider, no API calls)
AI_MODE=gemini

# Gemini incremental processing (avoid one API call per word)
GEMINI_UPDATE_INTERVAL_SECONDS=10
GEMINI_MIN_SEGMENTS_PER_UPDATE=3
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=3

# --- Database --------------------------------------------------------------
# PostgreSQL is the production/docker target.
DATABASE_URL=postgresql+asyncpg://medscribe:medscribe@localhost:5432/medscribe
# If PostgreSQL is unreachable at startup and this is true, MedScribe falls back
# to a local SQLite file so the prototype still runs. Never enable in production.
ALLOW_SQLITE_FALLBACK=true
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./medscribe_dev.db

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Simulation / demo -----------------------------------------------------
ENABLE_DEMO_MODE=true
# Seconds between simulated utterances in Demo Mode.
DEMO_SEGMENT_INTERVAL_SECONDS=2.5

# --- Pipeline providers ----------------------------------------------------
# mock | faster_whisper
ASR_PROVIDER=mock
# mock | pyannote
DIARIZATION_PROVIDER=mock
FASTER_WHISPER_MODEL=small.en
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
HUGGINGFACE_TOKEN=

# --- Audio -----------------------------------------------------------------
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_STORAGE_DIR=./storage/audio

# --- Security (development user system) ------------------------------------
DEV_AUTH_ENABLED=true
DEV_USER_EMAIL=dev.clinician@medscribe.local
DEV_USER_ROLE=DOCTOR
SECRET_KEY=change-me-in-production
DATA_RETENTION_DAYS=30

# --- Monitoring ------------------------------------------------------------
ENABLE_METRICS=true
